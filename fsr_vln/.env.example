# Usage: Copy this file to .env and fill in the required values.
# VLM / LLM provider configuration
# Set LLM_PROVIDER=azure to use Azure OpenAI; leave as "ollama" to use local Qwen/Ollama.
LLM_PROVIDER=ollama

# --- Azure OpenAI (used when LLM_PROVIDER=azure) ---
AZURE_OPENAI_ENDPOINT=xxxx
AZURE_OPENAI_API_KEY=xxxx
AZURE_OPENAI_API_VERSION=xxxx
AZURE_OPENAI_MODEL=xxxx

# --- Ollama / local model (used when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:latest

# ---------------------------------------------------------------------------
# HoloAgent Streamlit UI (holoagent_app.py)
# ---------------------------------------------------------------------------

# Config profile to load from config/holoagent_app/profiles/<name>.yaml
# Default: custom  (edit that file with your scene-specific paths and audio settings)
HOLOAGENT_PROFILE=custom
