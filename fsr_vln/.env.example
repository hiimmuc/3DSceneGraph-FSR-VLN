# Usage: Copy this file to .env and fill in the required values.
# VLM / LLM provider configuration
# Set LLM_PROVIDER=azure to use Azure OpenAI; leave as "ollama" to use local Qwen/Ollama.
LLM_PROVIDER=ollama

# --- Azure OpenAI (used when LLM_PROVIDER=azure) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_MODEL=

# --- Ollama / local model (used when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3-vl:4b
